  <step>
    <name>S1 katalog produk ECOM</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_nrg_ecom</connection>
    <sql>SELECT p.product_id, p.sku, p.product_name, p.brand,
       c.category_name  AS sub_kategori_ecom,
       pc.category_name AS kategori_ecom
FROM products p
LEFT JOIN categories c  ON c.category_id  = p.category_id
LEFT JOIN categories pc ON pc.category_id = c.parent_category_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
