    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Transform</jsScript_name>
        <jsScript_script>
// Late arriving dimension: produk sah di katalog ECOM tetapi belum ada di ERP.
// Dibuat baris dim_produk sementara (is_inferred=1, harga_pokok NULL) agar fakta tetap bisa dimuat;
// saat ERP mengirim material resmi, baris ini di-update (SCD tipe 1) dan pemetaan diperbarui.
var nama_produk_inf = nama_produk_sumber;
var merk_inf = trimStr(brand);
var kategori_inf = trimStr(kategori_ecom);
var sub_kategori_inf = trimStr(sub_kategori_ecom);
var status_produk_inf = 'INFERRED';
var pemasok_key_inf = -1;
var nama_pemasok_inf = 'Belum diketahui (menunggu ERP)';
var versi_inf = 1;
var berlaku_sejak_inf = str2date('1900-01-01', 'yyyy-MM-dd');
var berlaku_sampai_inf = str2date('9999-12-31', 'yyyy-MM-dd');
var is_current_inf = 1;
var is_inferred_inf = 1;
var sumber_data_inf = 'INFERRED dari S1 ECOM';
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Fungsi_bantu</jsScript_name>
        <jsScript_script>
// ---- fungsi bantu (dijalankan sekali saat step mulai) ----
var PPN = 1.11;
function trimStr(s) {
  if (s == null) return null;
  var t = String(s).replace(/^\s+|\s+$/g, '').replace(/\s+/g, ' ');
  return t.length == 0 ? null : t;
}
function upperStr(s) { var t = trimStr(s); return t == null ? null : t.toUpperCase(); }
function properStr(s) {
  var t = trimStr(s); if (t == null) return null;
  return t.toLowerCase().replace(/(^|[\s.,'-])([a-z])/g, function (m, p, c) { return p + c.toUpperCase(); });
}
function num(x) { return x == null ? null : parseFloat(String(x)); }
function r2(x) { return x == null ? null : Math.round(x * 100) / 100; }
// Normalisasi nomor HP ke format 08xxxxxxxx: buang non-digit, 62xxx -&gt; 0xxx, 8xxx -&gt; 08xxx
