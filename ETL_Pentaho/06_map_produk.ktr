      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>S1 turunkan material_no dari SKU</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Transform</jsScript_name>
        <jsScript_script>
// pola SKU ECOM: SKU-&lt;4 digit nomor material&gt;-&lt;sufiks acak&gt;  -&gt;  P-&lt;4 digit&gt;
var sumber = 'S1';
var m = String(upperStr(sku)).match(/^SKU-(\d{4})-\d+$/);
var kandidat_material = m != null ? 'P-' + m[1] : null;
var nama_produk_sumber = trimStr(product_name);
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Fungsi_bantu</jsScript_name>
        <jsScript_script>
// ---- fungsi bantu (dijalankan sekali saat step mulai) ----
var PPN = 1.11;
function trimStr(s) {
  if (s == null) return null;
  var t = String(s).replace(/^\s+|\s+$/g, '').replace(/\s+/g, ' ');
  return t.length == 0 ? null : t;
}
function upperStr(s) { var t = trimStr(s); return t == null ? null : t.toUpperCase(); }
function properStr(s) {
  var t = trimStr(s); if (t == null) return null;
  return t.toLowerCase().replace(/(^|[\s.,'-])([a-z])/g, function (m, p, c) { return p + c.toUpperCase(); });
}
function num(x) { return x == null ? null : parseFloat(String(x)); }
function r2(x) { return x == null ? null : Math.round(x * 100) / 100; }
// Normalisasi nomor HP ke format 08xxxxxxxx: buang non-digit, 62xxx -&gt; 0xxx, 8xxx -&gt; 08xxx
function normHp(s) {
  if (s == null) return null;
  var d = String(s).replace(/[^0-9]/g, '');
  if (d.indexOf('62') == 0) d = '0' + d.substring(2);
  else if (d.indexOf('8') == 0) d = '0' + d;
  return d.length == 0 ? null : d;
}
function truncDate(d) { return d == null ? null : str2date(date2str(d, 'yyyy-MM-dd'), 'yyyy-MM-dd'); }
function dateKey(d) { return d == null ? null : parseInt(date2str(d, 'yyyyMMdd'), 10); }
</jsScript_script>
      </jsScript>
    </jsScripts>
