<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>09_dim_pelanggan</name>
    <description>Dimensi pelanggan terpadu: S1 (web) + S2 (member toko) via nomor HP ternormalisasi, S3 per buyer.hash</description>
