  <step>
    <name>S1 order line + header order</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_nrg_ecom</connection>
    <sql>SELECT oi.order_item_id, oi.order_id, oi.line_no, oi.sku, oi.qty, oi.unit_price, oi.disc_amount,
       o.customer_id, o.order_ts, o.status AS order_status, o.voucher_id, o.payment_method,
       v.promo_code, v.valid_from AS voucher_valid_from,
       r.qty AS retur_qty_src, r.refund_amount AS retur_refund_src, r.status AS retur_status_src
FROM order_items oi
JOIN orders o           ON o.order_id = oi.order_id
LEFT JOIN vouchers v    ON v.voucher_id = o.voucher_id
LEFT JOIN order_returns r ON r.order_item_id = oi.order_item_id
ORDER BY oi.order_item_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
