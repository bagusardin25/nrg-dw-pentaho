  <step>
    <name>Kunci default, HPP &amp; margin kotor</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Transform</jsScript_name>
        <jsScript_script>
// order tanpa voucher -&gt; 'Tanpa Kampanye'; voucher yang kampanyenya gagal validasi S5 -&gt; -1 (default lookup)
if (voucher_id == null) id_kampanye = -2;

// HPP dari versi harga pokok yang berlaku pada tanggal transaksi (NULL bila produk inferred)
var hpp_satuan = harga_pokok == null ? null : r2(num(harga_pokok));
var hpp = hpp_satuan == null ? null : r2(num(qty) * hpp_satuan);
var margin_kotor = hpp == null ? null : r2(penjualan_netto - hpp - fee_komisi - fee_layanan);
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Fungsi_bantu</jsScript_name>
        <jsScript_script>
// ---- fungsi bantu (dijalankan sekali saat step mulai) ----
var PPN = 1.11;
function trimStr(s) {
  if (s == null) return null;
  var t = String(s).replace(/^\s+|\s+$/g, '').replace(/\s+/g, ' ');
  return t.length == 0 ? null : t;
}
function upperStr(s) { var t = trimStr(s); return t == null ? null : t.toUpperCase(); }
function properStr(s) {
  var t = trimStr(s); if (t == null) return null;
  return t.toLowerCase().replace(/(^|[\s.,'-])([a-z])/g, function (m, p, c) { return p + c.toUpperCase(); });
}
function num(x) { return x == null ? null : parseFloat(String(x)); }
function r2(x) { return x == null ? null : Math.round(x * 100) / 100; }
// Normalisasi nomor HP ke format 08xxxxxxxx: buang non-digit, 62xxx -&gt; 0xxx, 8xxx -&gt; 08xxx
function normHp(s) {
  if (s == null) return null;
  var d = String(s).replace(/[^0-9]/g, '');
  if (d.indexOf('62') == 0) d = '0' + d.substring(2);
  else if (d.indexOf('8') == 0) d = '0' + d;
  return d.length == 0 ? null : d;
}
function truncDate(d) { return d == null ? null : str2date(date2str(d, 'yyyy-MM-dd'), 'yyyy-MM-dd'); }
function dateKey(d) { return d == null ? null : parseInt(date2str(d, 'yyyyMMdd'), 10); }
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields><field><name>id_kampanye</name><rename>id_kampanye</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>Y</replace></field><field><name>hpp_satuan</name><rename>hpp_satuan</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>hpp</name><rename>hpp</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>margin_kotor</name><rename>margin_kotor</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
