  <step>
    <name>Hitung atribut tanggal</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Transform</jsScript_name>
        <jsScript_script>
var tanggal = dateAdd(tgl_awal, 'd', hari_ke);
var tanggal_key = dateKey(tanggal);
var tahun = parseInt(date2str(tanggal, 'yyyy'), 10);
var bulan = parseInt(date2str(tanggal, 'MM'), 10);
var hari_dalam_bulan = parseInt(date2str(tanggal, 'dd'), 10);
var hari_dalam_minggu = parseInt(date2str(tanggal, 'u'), 10);
var minggu_dalam_tahun = parseInt(date2str(tanggal, 'w'), 10);
var NAMA_HARI = ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu', 'Minggu'];
var NAMA_BULAN = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
var nama_hari = NAMA_HARI[hari_dalam_minggu - 1];
var is_akhir_pekan = hari_dalam_minggu &gt;= 6 ? 1 : 0;
var nama_bulan = NAMA_BULAN[bulan - 1];
var kuartal = Math.floor((bulan - 1) / 3) + 1;
var nama_kuartal = 'Q' + kuartal;
var tahun_bulan = date2str(tanggal, 'yyyy-MM');
var tahun_kuartal = tahun + '-Q' + kuartal;
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Fungsi_bantu</jsScript_name>
        <jsScript_script>
// ---- fungsi bantu (dijalankan sekali saat step mulai) ----
var PPN = 1.11;
function trimStr(s) {
  if (s == null) return null;
  var t = String(s).replace(/^\s+|\s+$/g, '').replace(/\s+/g, ' ');
  return t.length == 0 ? null : t;
}
function upperStr(s) { var t = trimStr(s); return t == null ? null : t.toUpperCase(); }
function properStr(s) {
  var t = trimStr(s); if (t == null) return null;
  return t.toLowerCase().replace(/(^|[\s.,'-])([a-z])/g, function (m, p, c) { return p + c.toUpperCase(); });
}
function num(x) { return x == null ? null : parseFloat(String(x)); }
function r2(x) { return x == null ? null : Math.round(x * 100) / 100; }
// Normalisasi nomor HP ke format 08xxxxxxxx: buang non-digit, 62xxx -&gt; 0xxx, 8xxx -&gt; 08xxx
function normHp(s) {
  if (s == null) return null;
  var d = String(s).replace(/[^0-9]/g, '');
  if (d.indexOf('62') == 0) d = '0' + d.substring(2);
  else if (d.indexOf('8') == 0) d = '0' + d;
  return d.length == 0 ? null : d;
}
function truncDate(d) { return d == null ? null : str2date(date2str(d, 'yyyy-MM-dd'), 'yyyy-MM-dd'); }
function dateKey(d) { return d == null ? null : parseInt(date2str(d, 'yyyyMMdd'), 10); }
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields><field><name>tanggal</name><rename>tanggal</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>tanggal_key</name><rename>tanggal_key</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>tahun</name><rename>tahun</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>bulan</name><rename>bulan</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>hari_dalam_bulan</name><rename>hari_dalam_bulan</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>hari_dalam_minggu</name><rename>hari_dalam_minggu</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>minggu_dalam_tahun</name><rename>minggu_dalam_tahun</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nama_hari</name><rename>nama_hari</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>is_akhir_pekan</name><rename>is_akhir_pekan</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nama_bulan</name><rename>nama_bulan</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>kuartal</name><rename>kuartal</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nama_kuartal</name><rename>nama_kuartal</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>tahun_bulan</name><rename>tahun_bulan</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>tahun_kuartal</name><rename>tahun_kuartal</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
