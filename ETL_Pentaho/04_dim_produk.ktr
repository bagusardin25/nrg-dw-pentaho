  <step>
    <name>Hitung berlaku_sampai &amp; is_current</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Transform</jsScript_name>
        <jsScript_script>
// versi berlaku s.d. sehari sebelum versi berikutnya; versi terakhir terbuka s.d. 9999-12-31
var berlaku_sampai = berlaku_berikutnya == null ? str2date('9999-12-31', 'yyyy-MM-dd') : dateAdd(berlaku_berikutnya, 'd', -1);
var is_current = berlaku_berikutnya == null ? 1 : 0;
var material_no_std = upperStr(material_no);
var nama_produk_std = trimStr(nama_produk);
var merk = trimStr(brand);
var kategori_std = trimStr(kategori);
var sub_kategori_std = trimStr(sub_kategori);
var status_produk = upperStr(status);
var nama_pemasok = trimStr(supplier);
var is_inferred = 0;
var sumber_data = 'ERP S4';
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Fungsi_bantu</jsScript_name>
        <jsScript_script>
// ---- fungsi bantu (dijalankan sekali saat step mulai) ----
var PPN = 1.11;
function trimStr(s) {
  if (s == null) return null;
  var t = String(s).replace(/^\s+|\s+$/g, '').replace(/\s+/g, ' ');
  return t.length == 0 ? null : t;
}
function upperStr(s) { var t = trimStr(s); return t == null ? null : t.toUpperCase(); }
function properStr(s) {
  var t = trimStr(s); if (t == null) return null;
  return t.toLowerCase().replace(/(^|[\s.,'-])([a-z])/g, function (m, p, c) { return p + c.toUpperCase(); });
}
function num(x) { return x == null ? null : parseFloat(String(x)); }
function r2(x) { return x == null ? null : Math.round(x * 100) / 100; }
// Normalisasi nomor HP ke format 08xxxxxxxx: buang non-digit, 62xxx -&gt; 0xxx, 8xxx -&gt; 08xxx
function normHp(s) {
  if (s == null) return null;
  var d = String(s).replace(/[^0-9]/g, '');
  if (d.indexOf('62') == 0) d = '0' + d.substring(2);
  else if (d.indexOf('8') == 0) d = '0' + d;
  return d.length == 0 ? null : d;
}
function truncDate(d) { return d == null ? null : str2date(date2str(d, 'yyyy-MM-dd'), 'yyyy-MM-dd'); }
function dateKey(d) { return d == null ? null : parseInt(date2str(d, 'yyyyMMdd'), 10); }
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields><field><name>berlaku_sampai</name><rename>berlaku_sampai</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>is_current</name><rename>is_current</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>material_no_std</name><rename>material_no_std</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nama_produk_std</name><rename>nama_produk_std</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>merk</name><rename>merk</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>kategori_std</name><rename>kategori_std</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>sub_kategori_std</name><rename>sub_kategori_std</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>status_produk</name><rename>status_produk</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nama_pemasok</name><rename>nama_pemasok</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>is_inferred</name><rename>is_inferred</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>sumber_data</name><rename>sumber_data</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
