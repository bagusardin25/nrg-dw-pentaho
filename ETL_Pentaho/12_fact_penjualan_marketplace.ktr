  <step>
    <name>Lookup id_kampanye</name>
    <type>DBLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_nrg_dw</connection>
    <cache>Y</cache>
    <cache_load_all>N</cache_load_all>
    <cache_size>0</cache_size>
    <lookup>
      <schema/>
      <table>dim_kampanye</table>
      <orderby>tanggal_mulai DESC</orderby>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>konstanta_1</name><field>berlaku_marketplace</field><condition>=</condition><name2/></key><key><name>tanggal</name><field>tanggal_mulai</field><condition>&lt;=</condition><name2/></key><key><name>tanggal</name><field>tanggal_selesai</field><condition>&gt;=</condition><name2/></key>
      <value><name>id_kampanye</name><rename>id_kampanye</rename><default>-1</default><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
