      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
      <key><name>material_no</name><field>material_no</field><condition>=</condition><name2/></key><key><name>tanggal</name><field>berlaku_sejak</field><condition>&lt;=</condition><name2/></key><key><name>tanggal</name><field>berlaku_sampai</field><condition>&gt;=</condition><name2/></key>
      <value><name>id_produk</name><rename>id_produk</rename><default>-1</default><type>Integer</type></value><value><name>harga_pokok</name><rename>harga_pokok</rename><default/><type>Number</type></value><value><name>id_pemasok</name><rename>id_pemasok</rename><default>-1</default><type>Integer</type></value>
    </lookup>
    <attributes/>
