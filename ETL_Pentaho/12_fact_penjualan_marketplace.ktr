  <step>
    <name>S3 item invoice (staging)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>conn_nrg_dw</connection>
    <sql>SELECT invoice, seller_sku, channel, buyer_hash, waktu_wib, qty,
       price_incl_ppn, voucher_incl_ppn, fee_commission_alok, fee_service_alok
FROM stg_mpl_item
ORDER BY invoice, seller_sku</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>60</xloc>
      <yloc>170</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Hitung nilai tanpa PPN</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Transform</jsScript_name>
        <jsScript_script>
// price &amp; voucher S3 sudah termasuk PPN 11% -&gt; dibagi 1,11
var harga_satuan_excl_ppn = r2(num(price_incl_ppn) / PPN);
var penjualan_bruto = r2(num(qty) * harga_satuan_excl_ppn);
var diskon_rp = r2(num(voucher_incl_ppn) / PPN);
var penjualan_netto = r2(penjualan_bruto - diskon_rp);
// fee commission &amp; service sudah dialokasikan per item di 05_stg_mpl
var fee_komisi = r2(num(fee_commission_alok));
var fee_layanan = r2(num(fee_service_alok));
var qty_retur = 0;
var nilai_retur = 0;
var waktu_transaksi_wib = waktu_wib;
var tanggal = truncDate(waktu_wib);
var id_tanggal = dateKey(tanggal);
var metode_pembayaran = 'MARKETPLACE';
var sumber_sistem = 'S3';
var map_sumber = 'S3';
var kanal_kode = trimStr(channel);
var nomor_transaksi = invoice;
var line_id = seller_sku;
var kode_produk_sumber = seller_sku;
var konstanta_1 = 1;
</jsScript_script>
      </jsScript>
      <jsScript>
        <jsScript_type>1</jsScript_type>
        <jsScript_name>Fungsi_bantu</jsScript_name>
        <jsScript_script>
// ---- fungsi bantu (dijalankan sekali saat step mulai) ----
var PPN = 1.11;
function trimStr(s) {
  if (s == null) return null;
  var t = String(s).replace(/^\s+|\s+$/g, '').replace(/\s+/g, ' ');
  return t.length == 0 ? null : t;
}
function upperStr(s) { var t = trimStr(s); return t == null ? null : t.toUpperCase(); }
function properStr(s) {
  var t = trimStr(s); if (t == null) return null;
  return t.toLowerCase().replace(/(^|[\s.,'-])([a-z])/g, function (m, p, c) { return p + c.toUpperCase(); });
}
function num(x) { return x == null ? null : parseFloat(String(x)); }
function r2(x) { return x == null ? null : Math.round(x * 100) / 100; }
// Normalisasi nomor HP ke format 08xxxxxxxx: buang non-digit, 62xxx -&gt; 0xxx, 8xxx -&gt; 08xxx
function normHp(s) {
  if (s == null) return null;
  var d = String(s).replace(/[^0-9]/g, '');
  if (d.indexOf('62') == 0) d = '0' + d.substring(2);
  else if (d.indexOf('8') == 0) d = '0' + d;
  return d.length == 0 ? null : d;
}
function truncDate(d) { return d == null ? null : str2date(date2str(d, 'yyyy-MM-dd'), 'yyyy-MM-dd'); }
function dateKey(d) { return d == null ? null : parseInt(date2str(d, 'yyyyMMdd'), 10); }
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields><field><name>harga_satuan_excl_ppn</name><rename>harga_satuan_excl_ppn</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>penjualan_bruto</name><rename>penjualan_bruto</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>diskon_rp</name><rename>diskon_rp</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>penjualan_netto</name><rename>penjualan_netto</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>fee_komisi</name><rename>fee_komisi</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>fee_layanan</name><rename>fee_layanan</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>qty_retur</name><rename>qty_retur</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nilai_retur</name><rename>nilai_retur</rename><type>Number</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>waktu_transaksi_wib</name><rename>waktu_transaksi_wib</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>tanggal</name><rename>tanggal</rename><type>Date</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>id_tanggal</name><rename>id_tanggal</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>metode_pembayaran</name><rename>metode_pembayaran</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>sumber_sistem</name><rename>sumber_sistem</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>map_sumber</name><rename>map_sumber</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>kanal_kode</name><rename>kanal_kode</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>nomor_transaksi</name><rename>nomor_transaksi</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>line_id</name><rename>line_id</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>kode_produk_sumber</name><rename>kode_produk_sumber</rename><type>String</type><length>-1</length><precision>-1</precision><replace>N</replace></field><field><name>konstanta_1</name><rename>konstanta_1</rename><type>Integer</type><length>-1</length><precision>-1</precision><replace>N</replace></field></fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
